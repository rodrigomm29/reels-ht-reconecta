# Copie este arquivo para `config.env` (o instalar.sh faz isso) e ajuste para a SUA máquina.
# O config.env NÃO vai para o git. Caminhos podem usar ~ e ${OUTRA_VARIAVEL}.
# Evite ":" e aspas simples nos caminhos (o ffmpeg não aceita isso dentro do filtro).

# ---------- pastas (obrigatórias) ----------
# Onde ficam os Reels baixados (videos/), as transcrições (transcricoes/) e o áudio temporário (audio/).
# Pode ser um HD externo. Ex.: REELS_BASE="/Volumes/MeuHD/reels-ana"
REELS_BASE="${PROJETO}/dados"

# Onde os vídeos prontos são gravados (uma pasta por semana e dia: SEM43/segunda/orgânico/...).
SAIDA_DIR="${PROJETO}/saida"

# ---------- tela dividida (estilo "dividida") ----------
# Pasta do SEU acervo de B-roll JÁ NORMALIZADO em 1080x956 (ver README, seção "B-roll").
# Sem ela, o estilo dividida não roda; os estilos clean e peles funcionam sem.
BROLL_DIR=""
# y padrão do topo da janela da pessoa (recorte 1080x964 da metade de baixo) quando o Reel não foi medido.
DIVIDIDA_Y_PADRAO=300

# ---------- conta e conteúdo ----------
IG_PERFIL="anadareconecta"
# Navegador logado no Instagram de onde sai a sessão para baixar os Reels: chrome, safari, firefox...
# Perfil específico do Chrome = nome da PASTA do perfil, ex.: "chrome:Profile 3"
NAVEGADOR="chrome"
CONTA_INSTAGRAM="@anadareconecta"
CONTA_TIKTOK="@anadareconecta"
HASHTAGS="#gestaodeclinica #harmonizacaofacial #secretariadeclinica #captacaodepacientes"
FUSO="America/Sao_Paulo"

# ---------- segredos ----------
# Recomendado no Mac: deixar VAZIO aqui e guardar no Keychain (ver README). Se preencher, nunca suba este arquivo.
ELEVENLABS_API_KEY=""
PUBLER_API_KEY=""
PUBLER_WORKSPACE_ID=""
# Nomes dos itens no Keychain (só mude se a sua equipe usa outros nomes)
KEYCHAIN_ELEVENLABS="elevenlabs-api-key"
KEYCHAIN_PUBLER="reconecta-publer"

# ---------- opcionais (só para os estilos com efeitos: peles manchete/cinema/dinâmica) ----------
# Kit de efeitos e SFX gerado pelo kit_peles.py. Sem kit, clean e dividida saem sem o som do obturador.
KIT_DIR="${REELS_BASE}/kit_peles"
# Pacotes pagos de onde o kit_peles.py tira efeitos e sons (só quem tem a licença).
CINEVA_DIR=""
PACK_EDITOR_DIR=""
# LUTs .cube da pele "cinema" (qualquer .cube serve). LUT_n pode ser nome dentro de LUTS_DIR ou caminho completo.
LUTS_DIR=""
LUT_1=""
LUT_2=""
LUT_3=""
# Tela final de CTA (só versões de anúncio, com tela final; o orgânico não usa).
TELA_FINAL=""

# ---------- posts de foto (antes/depois em carrossel) ----------
# Pasta que a pessoa preenche (uma subpasta por post, com as fotos e, se quiser, legenda.txt). Vazio = a pasta
# "Posts Fernanda" no iCloud Drive. As fotos tratadas vão para FOTOS_DIR (vazio = $REELS_BASE/fotos).
POSTS_FOTOS_DIR=""
FOTOS_DIR=""

# ---------- fontes ----------
# A Inter (livre, OFL) vem na pasta fontes/. Grift e 403 Degrad Mono são pagas e só as peles antigas usam.
FONTES_DIR="${PROJETO}/fontes"

# Transcrição: "scribe" (ElevenLabs, pago, tempo de palavra preciso) ou "local" (Whisper no Mac, grátis, só pra teste: o tempo das palavras sai impreciso)
TRANSCRICAO="scribe"

# Faixa da legenda queimada dos Reels originais em 1080x1920 (OCR do blocos_legenda.py)
LEGENDA_FAIXA_Y=1200
LEGENDA_FAIXA_H=440
LEGENDA_MIN_TEXTO=240

# Centro vertical da caixa de título (pele "texto") em 1080x1920
TITULO_CY=1130

# Vídeos brutos: velocidade da fala, legenda "palavra" ou "frase", título "caixa" ou "texto"
VELOCIDADE_FALA=1.0
LEGENDA_MODO=palavra
TITULO_MODO=caixa

# Reels publicados antes desta data não voltam como Reel base (AAAA-MM-DD; vazio = sem corte)
DATA_CORTE=
